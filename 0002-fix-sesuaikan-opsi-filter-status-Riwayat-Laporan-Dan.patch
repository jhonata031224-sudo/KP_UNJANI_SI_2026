From 42f73355f7867f6e65d7a1c5f576f4d01cc358a0 Mon Sep 17 00:00:00 2001
From: Claude Assistant <claude-assistant@local>
Date: Thu, 20 Aug 2026 03:40:34 +0000
Subject: [PATCH 2/2] fix: sesuaikan opsi filter status Riwayat Laporan Danpus
 sesuai permintaan
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Ganti opsi filter status pada section #status (Riwayat Laporan - Danpus)
dari 8 opsi menjadi 7 opsi final:
Semua Status, Disetujui, Ditolak, Terlambat, Dibatalkan,
Selesai · Ditolak, Selesai · Disetujui.

- Hapus opsi 'Sedang diproses', 'Menunggu', 'Revisi' (tidak relevan untuk
  Riwayat Laporan Danpus karena tabel ini isinya keputusan final/arsip).
- Tambah opsi 'Disetujui' dan 'Ditolak' untuk baris laporan final yang
  statusnya tampil polos tanpa prefix 'Selesai ·' (mis. status Laporan
  langsung: Disetujui/Ditolak/Disetujui DANPUS/dst), terpisah dari status
  arsip permintaan laporan yang selalu berformat 'Selesai · ...'.
- prepareRow disesuaikan: baris dengan teks status mengandung kata
  'selesai' dikategorikan ke 'Selesai · Disetujui'/'Selesai · Ditolak',
  selain itu ke 'Disetujui'/'Ditolak' polos.
- Filter di section #permintaan-laporan dan #riwayat (sisi satuan) tidak
  diubah, tetap seperti semula.
---
 .../dashboards/partials/danpus-report-table-filter.blade.php | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/resources/views/siberad/dashboards/partials/danpus-report-table-filter.blade.php b/resources/views/siberad/dashboards/partials/danpus-report-table-filter.blade.php
index e8afc424..fbc25a81 100644
--- a/resources/views/siberad/dashboards/partials/danpus-report-table-filter.blade.php
+++ b/resources/views/siberad/dashboards/partials/danpus-report-table-filter.blade.php
@@ -142,10 +142,11 @@
     });
     initReportFilter({
       sectionId:'status',tableSelector:'.clean-table',anchorSelector:'.section-head-clean',searchPlaceholder:'Cari satuan atau perihal...',emptyText:'Tidak ada laporan yang sesuai dengan pencarian/filter.',
-      filters:[{label:'Filter status',attr:'reportStatus',options:[{value:'all',label:'Semua Status'},{value:'Sedang diproses',label:'Sedang diproses'},{value:'Menunggu',label:'Menunggu'},{value:'Revisi',label:'Revisi'},{value:'Terlambat',label:'Terlambat'},{value:'Dibatalkan',label:'Dibatalkan'},{value:'Selesai · Ditolak',label:'Selesai · Ditolak'},{value:'Selesai · Disetujui',label:'Selesai · Disetujui'}]}],sortable:true,
+      filters:[{label:'Filter status',attr:'reportStatus',options:[{value:'all',label:'Semua Status'},{value:'Disetujui',label:'Disetujui'},{value:'Ditolak',label:'Ditolak'},{value:'Terlambat',label:'Terlambat'},{value:'Dibatalkan',label:'Dibatalkan'},{value:'Selesai · Ditolak',label:'Selesai · Ditolak'},{value:'Selesai · Disetujui',label:'Selesai · Disetujui'}]}],sortable:true,
       prepareRow:function(row){
         var raw=(row.querySelector('td:nth-child(4)')?.textContent||'').trim().toLowerCase();
-        row.dataset.reportStatus=raw.includes('terl')?'Terlambat':raw.includes('batal')?'Dibatalkan':raw.includes('tolak')?'Selesai · Ditolak':(raw.includes('setuj')||raw.includes('diterima'))?'Selesai · Disetujui':raw.includes('revisi')?'Revisi':raw.includes('menunggu')?'Menunggu':(raw.includes('progres')||raw.includes('proses'))?'Sedang diproses':'Sedang diproses';
+        var isSelesai=raw.includes('selesai');
+        row.dataset.reportStatus=raw.includes('terl')?'Terlambat':raw.includes('batal')?'Dibatalkan':raw.includes('tolak')?(isSelesai?'Selesai · Ditolak':'Ditolak'):(raw.includes('setuj')||raw.includes('diterima'))?(isSelesai?'Selesai · Disetujui':'Disetujui'):'';
       }
     });
     initReportFilter({
